[gd_resource type="Theme" load_steps=10 format=3]

[ext_resource type="FontFile" path="res://assets/fonts/Jersey10.ttf" id="1_font"]
[ext_resource type="Texture2D" path="res://assets/ui/btn_normal.png" id="t_n"]
[ext_resource type="Texture2D" path="res://assets/ui/btn_hover.png" id="t_h"]
[ext_resource type="Texture2D" path="res://assets/ui/btn_pressed.png" id="t_p"]

[sub_resource type="StyleBoxFlat" id="panel"]
bg_color = Color(0.09, 0.07, 0.13, 1)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.55, 0.15, 0.2, 1)

[sub_resource type="StyleBoxTexture" id="btn"]
texture = ExtResource("t_n")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0
content_margin_left = 5.0
content_margin_top = 2.0
content_margin_right = 5.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxTexture" id="btn_hover"]
texture = ExtResource("t_h")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0
content_margin_left = 5.0
content_margin_top = 2.0
content_margin_right = 5.0
content_margin_bottom = 2.0

[sub_resource type="StyleBoxTexture" id="btn_pressed"]
texture = ExtResource("t_p")
texture_margin_left = 3.0
texture_margin_top = 3.0
texture_margin_right = 3.0
texture_margin_bottom = 3.0
content_margin_left = 5.0
content_margin_top = 2.0
content_margin_right = 5.0
content_margin_bottom = 2.0

[resource]
default_font = ExtResource("1_font")
default_font_size = 10
Button/styles/disabled = SubResource("btn")
Button/styles/focus = SubResource("btn_hover")
Button/styles/hover = SubResource("btn_hover")
Button/styles/normal = SubResource("btn")
Button/styles/pressed = SubResource("btn_pressed")
Label/colors/font_outline_color = Color(0, 0, 0, 1)
Label/constants/outline_size = 2
Panel/styles/panel = SubResource("panel")
